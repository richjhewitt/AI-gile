{
  "name": "AI-gile",
  "short_name": "AI-gile",
  "description": "Your board and your AI teams, in your pocket",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#3b6cf6",
  "background_color": "#12151b",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New card", "short_name": "New card", "url": "/?launch=new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Inbox", "short_name": "Inbox", "url": "/?launch=inbox", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Messages", "short_name": "Messages", "url": "/?launch=messages", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": { "action": "/", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } }
}
